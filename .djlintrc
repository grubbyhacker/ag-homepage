{
  "profile": "jinja",
  "indent": 2,
  "max_line_length": 120,
  "max_attribute_length": 80,
  "format_attribute_template_tags": false,
  "preserve_leading_space": true,
  "preserve_blank_lines": true,
  "ignore": "H006,H031",
  "extend_ignore": "",
  "exclude": ".git,public,resources",
  "custom_blocks": "define,block",
  "custom_html": ""
}
